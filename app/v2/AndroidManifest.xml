<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.blimark.fieldkit.v2">

    <!-- Bluetooth: the split permissions on Android 12+, the old pair below it. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 6-11 gate Bluetooth scans behind location; nothing newer needs it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- The lock-screen ICE card. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- No INTERNET ever, and no all-files access either. Library reads through the
         folder the user hands over in the system picker (ACTION_OPEN_DOCUMENT_TREE),
         which needs no permission at all. READ_EXTERNAL_STORAGE is capped at Android
         9: it is only the fallback for a phone without the tree picker, and above
         API 28 scoped storage means it would grant nothing anyway. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- USB host is optional: the inspector reports what it finds, and the app
         still installs on a phone with no host port. No permission is needed to
         list host-mode devices or to read a descriptor blob. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="FieldKit V2"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/FieldKitTheme"
        android:usesCleartextTraffic="false">

        <!-- Serves one library file, read-only, to the app the user tapped. -->
        <provider
            android:name=".LibraryFiles"
            android:authorities="se.blimark.fieldkit.v2.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".V2Activity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="FieldKit V2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
